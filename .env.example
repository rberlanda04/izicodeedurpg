# Copie para .env.local (nunca commitado) e preencha com as credenciais
# do seu projeto Firebase: Console Firebase > Configurações do projeto > Seus apps > SDK setup.
#
# Propositalmente sem VITE_FIREBASE_MEASUREMENT_ID / Analytics: o app trata
# dados de menores de idade e não deve enviar telemetria de terceiros sem
# opt-in explícito (ver PLANO_DESENVOLVIMENTO.md, seção 12.4).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-side only — deliberately NOT prefixed with VITE_, so Vite never
# bundles it into client code. Powers local AI content generation via the
# dev-server proxy in vite.config.ts (server/aiContentHandler.ts). Get a key
# at https://build.nvidia.com.
NVIDIA_API_KEY=
