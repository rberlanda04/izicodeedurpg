# Copie para .env.local (nunca commitado) e preencha com as credenciais
# do seu projeto Firebase: Console Firebase > Configurações do projeto > Seus apps > SDK setup.
#
# Propositalmente sem VITE_FIREBASE_MEASUREMENT_ID / Analytics: o app trata
# dados de menores de idade e não deve enviar telemetria de terceiros sem
# opt-in explícito (ver PLANO_DESENVOLVIMENTO.md, seção 12.4).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-side only — deliberately NOT prefixed with VITE_, so Vite never
# bundles it into client code. Powers AI content generation via two paths
# that share server/aiContentHandler.ts: the dev-server proxy in
# vite.config.ts (local `npm run dev`) and api/generate-content.ts (Vercel
# production — also set this same value as a Vercel project env var, since
# .env.local is never deployed). Get a key at https://build.nvidia.com.
NVIDIA_API_KEY=

# Server-side only, powers the self-service "create my school" onboarding
# flow (server/onboardSchoolHandler.ts + api/onboard-school.ts) — needs
# Admin SDK access to Firestore, bypassing firestore.rules by design. In
# local dev this isn't read from here; a service-account.json file in the
# repo root (gitignored) is used instead if present — see
# server/firebaseAdmin.ts. Only needed as an actual env var on Vercel, where
# there's no file to mount: base64-encode the same service account JSON
# (Firebase Console > Project Settings > Service Accounts > Generate new
# private key) with `base64 -w0 service-account.json` and set the output as
# this variable in the Vercel project's environment variables.
FIREBASE_SERVICE_ACCOUNT_BASE64=
