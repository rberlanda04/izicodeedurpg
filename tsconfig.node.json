{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* moduleResolution "bundler" (not "nodenext"): Vercel's function builder
       transpiles each api/*.ts file individually and traces+includes local
       imports as real sibling .js files (e.g. server/aiContentHandler.js),
       WITHOUT rewriting the import specifiers — and since package.json has
       "type": "module", the deployed function runs under native Node ESM,
       which requires the import specifier to exactly match the file on
       disk. So relative imports here MUST use a literal ".js" extension
       (the eventual compiled output), never ".ts" and never omitted — "ts"
       extensions or missing ones both produced ERR_MODULE_NOT_FOUND in
       production because Node looked for a file that didn't exist.
       "bundler" resolution (matching tsconfig.app.json) still resolves
       these ".js" specifiers against the real ".ts" source files for
       type-checking and works correctly under Vite/tsx too. */
    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "api", "scripts"]
}
